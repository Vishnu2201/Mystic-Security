# Mystic Security Platform - Environment Configuration Template
# Copy this file to .env for local development

# System Environment
ENVIRONMENT=development
DEBUG=true

# Backend FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL - Phase 0.1 Foundation Setup)
# Use POSTGRES_SERVER=localhost for local python execution, or POSTGRES_SERVER=db inside Docker Compose
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mystic_security
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mystic_security
